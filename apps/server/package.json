{
  "name": "sqlmal",
  "version": "0.1.0",
  "description": "PostgreSQL migrations from the command line, with a live map of your schema, a replayable timeline and drift detection.",
  "license": "MIT",
  "bin": {
    "sqlmal": "dist/main.js"
  },
  "files": [
    "dist",
    "ui"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build && node scripts/copy-web-ui.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch -- serve",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns e2e-spec",
    "test:e2e": "jest --testPathPatterns e2e-spec --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nest-commander": "^3.21.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@sqlmal/contracts": "*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.2"
  }
}
